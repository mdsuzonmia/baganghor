# Copy this file to .env and never commit real secrets.
CI_ENVIRONMENT = production
app.baseURL = 'https://example.com/'
app.indexPage = ''
app.forceGlobalSecureRequests = true
APP_TIMEZONE = 'Asia/Dhaka'

database.default.hostname = localhost
database.default.database = taharat_agro
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix = CVTAGX_
database.default.port = 3306

# Alpha SMS (sms.bd) transactional gateway. Keep the key private.
sms.apiKey =
sms.senderId =

# Set strong, private values before running DatabaseSeeder.
TAHARAT_ADMIN_NAME = 'Taharat Agro Admin'
TAHARAT_ADMIN_EMAIL = 'admin@taharatagro.com'
TAHARAT_ADMIN_PASSWORD = '12Ta4130?'
