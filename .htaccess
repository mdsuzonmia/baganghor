Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /taharat_agro/

    # Keep public/ internal and redirect old bookmarked public URLs.
    RewriteCond %{THE_REQUEST} \s/+taharat_agro/public/ [NC]
    RewriteRule ^public(?:/(.*))?$ /taharat_agro/$1 [R=301,L,NE]

    # Never expose framework source, dependencies, runtime data, or secrets.
    RewriteRule ^(?:app|vendor|writable|tests|build)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\.example)?|env|composer\.(?:json|lock)|phpunit\.dist\.xml|spark|preload\.php|builds)(?:/|$) - [F,L,NC]

    # Serve browser assets from the real public directory.
    RewriteCond %{DOCUMENT_ROOT}/taharat_agro/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/taharat_agro/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Send application requests to CI4's front controller.
    RewriteRule ^$ public/index.php [L,NC,QSA]
    RewriteRule ^(.+)$ public/index.php/$1 [L,NC,QSA]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 /taharat_agro/public/index.php
</IfModule>

ServerSignature Off
