Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass bearer/basic authentication through to PHP.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Keep public/ out of browser-visible URLs. These conditions ensure that
    # the redirect applies only to a client request, not our internal rewrite.
    RewriteCond %{THE_REQUEST} \s/+[^?\ ]*public/?[?\ ] [NC]
    RewriteRule ^public/?$ ./ [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+[^?\ ]*public/ [NC]
    RewriteRule ^public/(.+)$ $1 [R=301,L,NE]

    # Never expose framework source, dependencies, runtime data, or secrets.
    RewriteRule ^(?:app|vendor|writable|tests|build)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\.example)?|env|composer\.(?:json|lock)|phpunit\.dist\.xml|spark|preload\.php|builds)(?:/|$) - [F,L,NC]

    # Route everything through the real web root. Once rewritten, stop this
    # outer .htaccess from processing the request again; public/.htaccess will
    # serve real assets or send application routes to index.php.
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^$ public/index.php [L,NC,QSA]
    RewriteRule ^(.+)$ public/$1 [L,NC,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 public/index.php
</IfModule>

ServerSignature Off
